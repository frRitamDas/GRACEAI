# ---------------------------------------------------------------------------
# Grace AI environment
# Copy to .env.local and fill in what you have. Nothing here is required to
# open the app: without a database it uses a local JSON store, and without a
# provider key the model picker explains what is missing.
# ---------------------------------------------------------------------------

# --- Model providers (server only; never prefixed NEXT_PUBLIC_) -------------
# Paste the real key after the "=". A value that still reads "PASTE_...",
# "your-key", "replace-me" or "changeme" is treated as unset on purpose, so a
# half-filled deployment never claims a provider is connected when it is not.
#
# OpenRouter: one key for Claude, GPT, Gemini and more
OPENROUTER_API_KEY=
# Groq: fast open models (Llama, Kimi, Qwen, GPT-OSS)
GROQ_API_KEY=
# Google AI Studio: Gemini models
GOOGLE_AI_API_KEY=
# NVIDIA NIM: Nemotron (OpenAI-compatible endpoint)
NVIDIA_API_KEY=

# --- GitHub ----------------------------------------------------------------
# Two ways to connect a repository, and neither is required to run the app.
#
# 1. OAuth app (recommended for other people's repos). Create one at
#    github.com/settings/developers, then set the callback URL to
#    {GRACE_APP_URL}/api/github/oauth/callback. Leave both blank and the
#    Connect panel simply hides the OAuth button and offers a token instead.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 2. A personal access token can always be pasted in the Connect panel; that
#    path needs no app registration and is what runs in local development.

# GitHub Enterprise Server, or a local stub while developing:
# GITHUB_API_BASE_URL=https://github.example.com/api/v3

# --- Storage (Supabase) ----------------------------------------------------
# Either a direct Postgres URL (what the Supabase Vercel integration injects)
POSTGRES_URL=
# ...or the Supabase REST credentials
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- App -------------------------------------------------------------------
# Used for OpenRouter attribution and absolute links
GRACE_APP_URL=http://localhost:3000
